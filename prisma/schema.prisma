generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  order     Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                String                 @id @default(cuid())
  name              String
  description       String?
  price             Float
  discountPrice     Float?
  imageUrl          String?
  available         Boolean                @default(true)
  availableDelivery Boolean                @default(true)
  availablePickup   Boolean                @default(true)
  category          Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId        String
  modifierGroups    ProductModifierGroup[]
  orderItems        OrderItem[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

enum ModifierType {
  SINGLE
  MULTIPLE
  REMOVE
}

model ModifierGroup {
  id        String                 @id @default(cuid())
  name      String
  type      ModifierType
  min       Int                    @default(0)
  max       Int                    @default(1)
  active    Boolean                @default(true)
  options   ModifierOption[]
  products  ProductModifierGroup[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model ModifierOption {
  id        String        @id @default(cuid())
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  title     String
  price     Float         @default(0)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ProductModifierGroup {
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  order     Int           @default(0)

  @@id([productId, groupId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum PaymentProvider {
  CASH
  MP
  MODO
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

// Cliente que compró alguna vez. Se deduplica por teléfono normalizado
// (normalizeArPhone). Los datos de contacto también quedan copiados en cada
// Order (snapshot histórico); acá se guarda la versión "actual" del cliente.
model Customer {
  id        String   @id @default(cuid())
  // Teléfono normalizado, formato 549XXXXXXXXXX (sin "+"). Clave de dedup.
  phone     String   @unique
  firstName String
  lastName  String   @default("")
  email     String?
  orders    Order[]
  // ~ fecha del primer pedido del cliente.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firstName])
}

model Order {
  id                String      @id @default(cuid())
  // Número secuencial legible para nombrar el pedido (comanda, seguimiento,
  // mensaje al repartidor). El id sigue siendo el cuid para los links.
  number            Int         @unique @default(autoincrement())
  orderType         OrderType
  // Cliente asociado. Se resuelve por teléfono al crear el pedido; null si el
  // pedido no trae un teléfono normalizable (algunas cargas manuales).
  customer          Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId        String?
  customerFirstName String
  customerLastName  String
  customerPhone     String
  customerEmail     String?
  deliveryAddress   String?
  deliveryFee       Float       @default(0)
  total             Float
  status            OrderStatus @default(PENDING)
  // Demora extra en minutos que carga el local para este pedido puntual; se
  // suma al tiempo de preparación del canal (Settings.prepTime*Minutes).
  extraDelayMinutes Int         @default(0)
  notes             String?
  // Motivo que el local escribe al cancelar un pedido desde la comanda.
  // Obligatorio en la transición a CANCELLED; interno (no se muestra al cliente).
  cancelReason      String?
  items             OrderItem[]
  payment           Payment?
  // Repartidor asignado (solo pedidos de envío). Si se borra el repartidor,
  // el pedido queda sin asignar pero no se pierde.
  driver            Driver?     @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([customerId])
}

model Driver {
  id           String   @id @default(cuid())
  name         String
  phone        String
  vehicle      String?
  licensePlate String?
  documentId   String?
  address      String?
  notes        String?
  active       Boolean  @default(true)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OrderItem {
  id          String            @id @default(cuid())
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  // El producto se puede borrar del catálogo aunque tenga pedidos: el ítem
  // conserva productName/price/options como snapshot y productId queda en null.
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  productName String
  price       Float
  quantity    Int
  notes       String?
  options     OrderItemOption[]
}

model OrderItemOption {
  id          String    @id @default(cuid())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String
  name        String
  price       Float
}

model Payment {
  id          String          @id @default(cuid())
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String          @unique
  provider    PaymentProvider
  status      PaymentStatus   @default(PENDING)
  amount      Float
  changeFor   Float?
  providerRef String?
  rawPayload  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Settings {
  id            String   @id @default("singleton")
  deliveryFee   Float    @default(0)
  storeName     String   @default("Rowlys")
  storePhone    String?
  storeAddress  String?
  bankAlias     String?
  // Estado del local. storeOpen=false => el cliente puede VER el menu pero no
  // hacer pedidos (banner con closedTitle/closedMessage). deliveryEnabled /
  // pickupEnabled cierran un canal puntual sin cerrar todo el local. Todo se
  // togglea desde el header de /comanda.
  storeOpen       Boolean  @default(true)
  deliveryEnabled Boolean  @default(true)
  pickupEnabled   Boolean  @default(true)
  closedTitle     String?
  closedMessage   String?
  closedImageUrl  String?
  // Tiempo de preparación estimado por canal (minutos). Se muestra en el
  // checkout y en el seguimiento del pedido. Editable desde /comanda.
  prepTimeDeliveryMinutes Int @default(10)
  prepTimePickupMinutes   Int @default(10)
  // Personalización visual de la carta online (etapa 1 hacia multi-tenant:
  // hoy vive en la fila única de Settings; el día que exista un modelo
  // Tenant, estos dos campos se mudan ahí tal cual). themeColor es el color
  // de marca elegido libremente por el local (hex); el resto de la paleta
  // del storefront (texto/tinte, botón sólido, hover, color de texto sobre
  // el botón) se DERIVA de este valor en src/lib/theme-color.ts, nunca se
  // guarda calculado, para poder ajustar la fórmula sin migrar datos.
  // themeFont es la clave de una tipografía curada (src/lib/storefront-fonts.ts).
  themeColor String @default("#c92a2a")
  themeFont  String @default("inter")
  // "Color secundario" en la jerga del local: blanco o negro, el texto/
  // íconos que van SOBRE themeColor (el "+", el texto de los botones). Es
  // una elección manual, no calculada — reemplaza el contraste automático
  // que sugiere src/lib/theme-color.ts cuando el local no tocó esto todavía.
  themeOnAccent String @default("white")
  updatedAt       DateTime @updatedAt
}
