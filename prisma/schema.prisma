generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Multi-tenant (Fase 26a) -----------------------------------------------
//
// "Cliente de Blend" = un local que usa el sistema (Rowlys es el primero).
// tenantId en los modelos de abajo empieza NULLABLE a propósito: se agrega,
// se hace `db push`, se backfillea con un script (todo lo existente pasa a
// pertenecer al tenant "rowlys"), y RECIÉN AHÍ se pasa a obligatorio — así
// nunca hay una ventana donde el create/push falle por un NOT NULL sin
// default. El código de la app (rutas, queries) todavía NO lee/filtra por
// tenantId — eso es la Fase 26b (routing + auth por tenant). Esta fase es
// puramente aditiva: nada de lo que ya funciona debería cambiar de
// comportamiento.

model Tenant {
  id             String          @id @default(cuid())
  // Identificador en la URL (ej. "rowlys" en blend.app/rowlys/menu). Solo
  // minúsculas/números/guiones, se valida en la capa de alta (super-admin).
  slug           String          @unique
  name           String
  active         Boolean         @default(true)
  settings       Settings?
  users          User[]
  categories     Category[]
  products       Product[]
  modifierGroups ModifierGroup[]
  customers      Customer[]
  orders         Order[]
  drivers        Driver[]
  coupons        Coupon[]
  discounts      Discount[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// Login de cada local. `username` es único GLOBAL (no por tenant) a propósito
// (Fase 26b): así /login sigue siendo un solo formulario simple (usuario +
// contraseña, sin pedir "de qué local sos") y el tenant se resuelve solo con
// encontrar el User — no hace falta que el que inicia sesión sepa ningún
// slug. El super-admin de Blend (panel aparte, Fase 26c) NO usa esta tabla:
// sigue con su login propio por env vars, para no pisarse con esto.
model User {
  id           String   @id @default(cuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String
  order     Int        @default(0)
  products  Product[]
  discounts Discount[]
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id                String                 @id @default(cuid())
  name              String
  description       String?
  price             Float
  discountPrice     Float?
  imageUrl          String?
  available         Boolean                @default(true)
  availableDelivery Boolean                @default(true)
  availablePickup   Boolean                @default(true)
  category          Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId        String
  modifierGroups    ProductModifierGroup[]
  orderItems        OrderItem[]
  tenant            Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId          String?
  discountsAsTarget  Discount[] @relation("DiscountProduct")
  discountsAsTrigger Discount[] @relation("DiscountTrigger")
  discountsAsReward  Discount[] @relation("DiscountReward")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

enum ModifierType {
  SINGLE
  MULTIPLE
  REMOVE
}

model ModifierGroup {
  id        String                 @id @default(cuid())
  name      String
  type      ModifierType
  min       Int                    @default(0)
  max       Int                    @default(1)
  active    Boolean                @default(true)
  options   ModifierOption[]
  products  ProductModifierGroup[]
  tenant    Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model ModifierOption {
  id        String        @id @default(cuid())
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  title     String
  price     Float         @default(0)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ProductModifierGroup {
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  order     Int           @default(0)

  @@id([productId, groupId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum PaymentProvider {
  CASH
  MP
  MODO
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

// Cliente que compró alguna vez. Se deduplica por teléfono normalizado
// (normalizeArPhone). Los datos de contacto también quedan copiados en cada
// Order (snapshot histórico); acá se guarda la versión "actual" del cliente.
model Customer {
  id        String   @id @default(cuid())
  // Teléfono normalizado, formato 549XXXXXXXXXX (sin "+"). Clave de dedup
  // HOY todavía global (@unique); en la Fase 26b pasa a ser @@unique por
  // tenant, para que dos locales distintos puedan tener cada uno "su"
  // cliente con el mismo teléfono sin pisarse.
  phone     String   @unique
  firstName String
  lastName  String   @default("")
  email     String?
  orders    Order[]
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String?
  // ~ fecha del primer pedido del cliente.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firstName])
}

model Order {
  id                String      @id @default(cuid())
  // Número secuencial legible para nombrar el pedido (comanda, seguimiento,
  // mensaje al repartidor). El id sigue siendo el cuid para los links.
  number            Int         @unique @default(autoincrement())
  orderType         OrderType
  // Cliente asociado. Se resuelve por teléfono al crear el pedido; null si el
  // pedido no trae un teléfono normalizable (algunas cargas manuales).
  customer          Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId        String?
  customerFirstName String
  customerLastName  String
  customerPhone     String
  customerEmail     String?
  deliveryAddress   String?
  deliveryFee       Float       @default(0)
  total             Float
  status            OrderStatus @default(PENDING)
  // Demora extra en minutos que carga el local para este pedido puntual; se
  // suma al tiempo de preparación del canal (Settings.prepTime*Minutes).
  extraDelayMinutes Int         @default(0)
  notes             String?
  // Motivo que el local escribe al cancelar un pedido desde la comanda.
  // Obligatorio en la transición a CANCELLED; interno (no se muestra al cliente).
  cancelReason      String?
  items             OrderItem[]
  payment           Payment?
  // Repartidor asignado (solo pedidos de envío). Si se borra el repartidor,
  // el pedido queda sin asignar pero no se pierde.
  driver            Driver?     @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId          String?
  // Cupón usado en este pedido, si lo hubo.
  couponRedemption  CouponRedemption?
  // Descuentos automáticos (Directo/Combo/Método de pago/Envío gratis) que
  // se aplicaron solos a este pedido (Fase 28d). Distinto del cupón: acá no
  // hay "uso único", se recalculan reglas activas en cada pedido nuevo.
  discountApplications DiscountApplication[]
  // Suscripciones a notificaciones push del navegador para el seguimiento de
  // ESTE pedido (Fase 30) — no del cliente en general, así no hace falta
  // cuenta ni manejar consentimiento entre pedidos distintos.
  pushSubscriptions PushSubscription[]
  tenant            Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([tenantId])
}

model Driver {
  id           String   @id @default(cuid())
  name         String
  phone        String
  vehicle      String?
  licensePlate String?
  documentId   String?
  address      String?
  notes        String?
  active       Boolean  @default(true)
  orders       Order[]
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

// Marketing / Cupones (Fase 28, en construcción). `code` único global por
// ahora, mismo criterio de transición que `Customer.phone` (ver nota ahí) —
// el día que haya más de un tenant activo pasa a `@@unique([tenantId, code])`.
// Regla de uso decidida por el usuario: SIN tope global de usos, un cupón lo
// puede usar cada cliente (por teléfono) una sola vez — se controla con
// `CouponRedemption` + `@@unique([couponId, customerPhone])` de abajo.
// `budgetCap` es un techo opcional de $ descontados en total (no de cantidad
// de usos); se apaga solo cuando la suma de `CouponRedemption.discountAmount`
// lo alcanza. Todavía no hay ninguna ruta que cree `CouponRedemption` — eso
// es la Fase 28b (aplicar el cupón en el checkout), esta fase es solo el
// CRUD del panel.
model Coupon {
  id            String              @id @default(cuid())
  code          String              @unique
  discountType  CouponDiscountType
  // Porcentaje (1-100) si discountType=PERCENT, o monto fijo en $ si FIXED.
  discountValue Float
  budgetCap     Float?
  active        Boolean             @default(true)
  expiresAt     DateTime?
  redemptions   CouponRedemption[]
  tenant        Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model CouponRedemption {
  id             String   @id @default(cuid())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId       String
  customerPhone  String
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId        String?  @unique
  discountAmount Float
  createdAt      DateTime @default(now())

  @@unique([couponId, customerPhone])
}

// Marketing / Descuentos (Fase 28c, en construcción — solo el CRUD del panel
// por ahora, todavía no se aplica en el checkout). 4 tipos, tal como los
// pidió el usuario mirando el panel de RestoSimple:
//  - DIRECT: descuento (% o monto) sobre un producto puntual o toda una
//    categoría (uno de los dos, nunca ambos).
//  - COMBO ("2x1 / Combo"): comprás `triggerProduct`, se descuenta (% o
//    monto) `rewardProduct` — si son el mismo producto, es un 2x1 clásico.
//  - PAYMENT_METHOD: descuento (% o monto) sobre el total cuando el cliente
//    paga con un medio puntual (ej. 8% off en Transferencia).
//  - FREE_SHIPPING: bonifica el envío entero, no usa valueType/value.
enum DiscountKind {
  DIRECT
  COMBO
  PAYMENT_METHOD
  FREE_SHIPPING
}

enum DiscountValueType {
  PERCENT
  FIXED
}

enum DiscountTarget {
  PRODUCT
  CATEGORY
}

model Discount {
  id              String             @id @default(cuid())
  kind            DiscountKind
  title           String
  active          Boolean            @default(true)

  // DIRECT
  target          DiscountTarget?
  product         Product?           @relation("DiscountProduct", fields: [productId], references: [id], onDelete: Cascade)
  productId       String?
  category        Category?          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId      String?

  // DIRECT, COMBO y PAYMENT_METHOD lo usan; FREE_SHIPPING no.
  valueType       DiscountValueType?
  value           Float?

  // COMBO
  triggerProduct   Product?          @relation("DiscountTrigger", fields: [triggerProductId], references: [id], onDelete: Cascade)
  triggerProductId String?
  rewardProduct    Product?          @relation("DiscountReward", fields: [rewardProductId], references: [id], onDelete: Cascade)
  rewardProductId  String?

  // PAYMENT_METHOD
  paymentProvider PaymentProvider?

  applications    DiscountApplication[]
  tenant          Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

// Registro de que una regla de Discount se aplicó de verdad a un pedido, y
// por cuánto (Fase 28d). Separado del pedido para poder mostrar el detalle
// ("Directo -$500", "8% off en Efectivo -$1.200") igual que ya se hace con
// CouponRedemption. `discountId` es SetNull (no Cascade): si el local borra
// la regla después, el pedido ya facturado conserva el registro histórico
// (título y monto quedan congelados acá, no dependen de que la regla siga
// existiendo).
model DiscountApplication {
  id         String    @id @default(cuid())
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  discount   Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountId String?
  // Snapshot de discount.kind al momento de aplicarse (mismo criterio que
  // productName/price en OrderItem): discount.kind se pierde si se borra la
  // regla (onDelete: SetNull), y updateOrderItems necesita distinguir
  // FREE_SHIPPING de forma confiable aunque eso pase. Nullable porque las
  // filas creadas antes de este campo no lo tienen.
  kind       DiscountKind?
  title      String
  amount     Float
  createdAt  DateTime  @default(now())

  @@index([orderId])
}

// Notificaciones push del navegador (Fase 30): el cliente que sigue su
// pedido en /pedido/[id] activa esto para enterarse del cambio de estado sin
// tener la pestaña abierta. Alcance por PEDIDO (no por cliente/teléfono) a
// propósito — más simple que manejar consentimiento entre pedidos distintos,
// y se borra sola en cascada cuando el pedido se borra.
model PushSubscription {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  // Identifica el dispositivo/navegador ante el servicio push (FCM/Mozilla/
  // Apple); único porque suscribirse dos veces desde el mismo browser debe
  // pisar la fila anterior, no duplicarla.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id          String            @id @default(cuid())
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  // El producto se puede borrar del catálogo aunque tenga pedidos: el ítem
  // conserva productName/price/options como snapshot y productId queda en null.
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  productName String
  price       Float
  quantity    Int
  notes       String?
  options     OrderItemOption[]
}

model OrderItemOption {
  id          String    @id @default(cuid())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String
  name        String
  price       Float
}

model Payment {
  id          String          @id @default(cuid())
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String          @unique
  provider    PaymentProvider
  status      PaymentStatus   @default(PENDING)
  amount      Float
  changeFor   Float?
  providerRef String?
  rawPayload  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Settings {
  // Rowlys (el único Settings que existía antes de la Fase 26) quedó con
  // id literal "singleton" — no se migra, sigue siendo válido como cualquier
  // otro id. El default cambia a cuid() para que un tenant NUEVO (Fase 26c)
  // no choque intentando reusar el mismo id "singleton".
  id                      String   @id @default(cuid())
  deliveryFee             Float    @default(0)
  storeName               String   @default("Rowlys")
  storePhone              String?
  storeAddress            String?
  bankAlias               String?
  // Estado del local. storeOpen=false => el cliente puede VER el menu pero no
  // hacer pedidos (banner con closedTitle/closedMessage). deliveryEnabled /
  // pickupEnabled cierran un canal puntual sin cerrar todo el local. Todo se
  // togglea desde el header de /comanda.
  storeOpen               Boolean  @default(true)
  deliveryEnabled         Boolean  @default(true)
  pickupEnabled           Boolean  @default(true)
  closedTitle             String?
  closedMessage           String?
  closedImageUrl          String?
  // Tiempo de preparación estimado por canal (minutos). Se muestra en el
  // checkout y en el seguimiento del pedido. Editable desde /comanda.
  prepTimeDeliveryMinutes Int      @default(10)
  prepTimePickupMinutes   Int      @default(10)
  // Personalización visual de la carta online (etapa 1 hacia multi-tenant:
  // hoy vive en la fila única de Settings; el día que exista un modelo
  // Tenant, estos dos campos se mudan ahí tal cual). themeColor es el color
  // de marca elegido libremente por el local (hex); el resto de la paleta
  // del storefront (texto/tinte, botón sólido, hover, color de texto sobre
  // el botón) se DERIVA de este valor en src/lib/theme-color.ts, nunca se
  // guarda calculado, para poder ajustar la fórmula sin migrar datos.
  // themeFont es la clave de una tipografía curada (src/lib/storefront-fonts.ts).
  // coverImageUrl: foto de portada del header de /menu (mismo mecanismo de
  // subida que las imágenes de producto, ver src/lib/blob.ts). Null = header
  // plano de siempre, sin banner.
  coverImageUrl           String?
  // Ícono cuadrado (mismo mecanismo de subida) para la PWA instalable del
  // storefront (manifest.ts + apple-icon.tsx). Null = se genera uno
  // automático (inicial de storeName sobre themeColor) hasta que el local
  // suba el suyo — así es instalable desde el día 1 sin depender de que el
  // admin cargue un logo primero.
  iconUrl                 String?
  themeColor              String   @default("#c92a2a")
  themeFont               String   @default("inter")
  // "Color secundario" en la jerga del local: blanco o negro, el texto/
  // íconos que van SOBRE themeColor (el "+", el texto de los botones). Es
  // una elección manual, no calculada — reemplaza el contraste automático
  // que sugiere src/lib/theme-color.ts cuando el local no tocó esto todavía.
  themeOnAccent           String   @default("white")
  // 1:1 con Tenant. Nullable por ahora (ver nota de la Fase 26a arriba); el
  // día que haya más de un local, cada uno tiene su propia fila de Settings
  // (deja de ser singleton) identificada por este campo.
  tenant                  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId                String?  @unique
  updatedAt               DateTime @updatedAt
}
