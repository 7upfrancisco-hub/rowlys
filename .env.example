DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth panel admin/comanda (un solo usuario dueño del local)
AUTH_SECRET="genera-un-secreto-largo-random"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="hash-bcrypt-generado-localmente"

# Base URL pública, usada para armar links (seguimiento del pedido,
# back_urls/notification_url de pagos). En Vercel, si no se setea, se usa
# VERCEL_PROJECT_PRODUCTION_URL automáticamente.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Mercado Pago (wallet + transferencia/CVU vía Checkout Pro) — Fase 3
MP_ACCESS_TOKEN="TEST-xxxx"
MP_WEBHOOK_SECRET="xxxx"
# MP_MOCK="true" evita llamar a la API real: la preferencia apunta a
# /mock/mp/[orderId] y el webhook confía en el data.id. Se activa SOLO con el
# valor exacto "true" (nunca se infiere de la falta de token, para no exponer
# la página simuladora en producción). Sin mock y sin token, el checkout no
# ofrece Mercado Pago.
MP_MOCK="true"

# Modo — Fase 4
MODO_MERCHANT_ID=""
MODO_API_KEY=""
MODO_API_SECRET=""
MODO_WEBHOOK_SECRET=""
MODO_MOCK="true"

# WhatsApp (Meta Cloud API) — aviso automático al cliente cuando el local
# confirma el pedido (PENDING -> CONFIRMED), con link de seguimiento.
# WHATSAPP_MOCK="true" no llama a Meta: loguea el mensaje que se enviaría.
# Se activa SOLO con el valor exacto "true" (no se infiere de la falta de token).
WHATSAPP_MOCK="true"
WHATSAPP_TOKEN=""              # System User token permanente de Meta
WHATSAPP_PHONE_NUMBER_ID=""    # ID del número de WhatsApp Business
# Plantilla PRE-APROBADA en Meta (obligatoria para mensajes iniciados por el
# negocio). Debe tener 3 parámetros en el body: {{1}} nombre, {{2}} local,
# {{3}} link de seguimiento.
WHATSAPP_TEMPLATE_NAME="order_confirmed"
WHATSAPP_TEMPLATE_LANG="es_AR"

# Subida de imágenes de productos (Vercel Blob). Vercel inyecta esta variable
# sola cuando el proyecto tiene un Blob store vinculado (Storage -> Blob en el
# dashboard). Sin la variable, en dev local las imágenes se guardan en
# public/uploads/ (gitignored); en prod hace falta sí o sí el token.
BLOB_READ_WRITE_TOKEN=""
