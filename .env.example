DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth panel admin/comanda (un solo usuario dueño del local)
AUTH_SECRET="genera-un-secreto-largo-random"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="hash-bcrypt-generado-localmente"

# Base URL pública, usada para armar links (seguimiento del pedido,
# back_urls/notification_url de pagos). En Vercel, si no se setea, se usa
# VERCEL_PROJECT_PRODUCTION_URL automáticamente.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Mercado Pago (wallet + transferencia/CVU vía Checkout Pro) — Fase 3.
# MP_ACCESS_TOKEN es el token GLOBAL de respaldo: se usa para cualquier local
# que todavía no conectó su propia cuenta (ver MP_CLIENT_ID/SECRET abajo).
MP_ACCESS_TOKEN="TEST-xxxx"
MP_WEBHOOK_SECRET="xxxx"
# MP_MOCK="true" evita llamar a la API real: la preferencia apunta a
# /mock/mp/[orderId] y el webhook confía en el data.id. Se activa SOLO con el
# valor exacto "true" (nunca se infiere de la falta de token, para no exponer
# la página simuladora en producción). Sin mock y sin token, el checkout no
# ofrece Mercado Pago.
MP_MOCK="true"

# Mercado Pago OAuth ("Conectar con Mercado Pago" por local, desde
# /blend-admin) — Client ID/Secret de UNA aplicación dada de alta en
# https://www.mercadopago.com.ar/developers/panel/app. Ahí mismo hay que
# cargar la Redirect URI exacta: <tu dominio>/api/mercadopago/oauth/callback.
# Sin estas dos, el botón "Conectar" en /blend-admin muestra un error en vez
# de romper el resto de la app — todo sigue cobrando con MP_ACCESS_TOKEN.
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""

# Clave de cifrado para los tokens de Mercado Pago que cada local conecta
# (se guardan encriptados, nunca en texto plano — ver src/lib/crypto.ts).
# Generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# WhatsApp (Meta Cloud API) — aviso automático al cliente cuando el local
# confirma el pedido (PENDING -> CONFIRMED), con link de seguimiento.
# WHATSAPP_MOCK="true" no llama a Meta: loguea el mensaje que se enviaría.
# Se activa SOLO con el valor exacto "true" (no se infiere de la falta de token).
WHATSAPP_MOCK="true"
WHATSAPP_TOKEN=""              # System User token permanente de Meta
WHATSAPP_PHONE_NUMBER_ID=""    # ID del número de WhatsApp Business
# Plantilla PRE-APROBADA en Meta (obligatoria para mensajes iniciados por el
# negocio). Debe tener 3 parámetros en el body: {{1}} nombre, {{2}} local,
# {{3}} link de seguimiento.
WHATSAPP_TEMPLATE_NAME="order_confirmed"
WHATSAPP_TEMPLATE_LANG="es_AR"

# Notificaciones push del navegador (Fase 30) — avisan al cliente que sigue
# su pedido en /pedido/[id] cuando cambia de estado, sin depender de que
# tenga la pestaña abierta ni de la plantilla aprobada de WhatsApp. Se
# generan una sola vez por proyecto con `npx web-push generate-vapid-keys`
# y son las mismas en todos los entornos (dev/prod) — no rotan por local
# como sí hace AUTH_SECRET. Sin estas dos variables, el botón "Activar
# notificaciones" no aparece (mismo criterio de "mock/enabled explícito"
# que WhatsApp/MP/Modo).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto que ven los servicios push (Apple/Google) si necesitan avisar algo
# sobre el uso de la key (ej. cuota excedida). Puede ser "mailto:..." o una
# URL; con vacío se usa NEXT_PUBLIC_BASE_URL.
VAPID_SUBJECT=""

# Subida de imágenes de productos (Vercel Blob). Vercel inyecta esta variable
# sola cuando el proyecto tiene un Blob store vinculado (Storage -> Blob en el
# dashboard). Sin la variable, en dev local las imágenes se guardan en
# public/uploads/ (gitignored); en prod hace falta sí o sí el token.
BLOB_READ_WRITE_TOKEN=""
